{
  "name": "feelio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "assets:build": "tsx scripts/build-assets.ts",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "content:build": "tsx scripts/build-world-registry.ts && tsx scripts/build-assets.ts",
    "redteam": "tsx --conditions=react-server scripts/redteam.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@elevenlabs/react": "1.16.0",
    "@neondatabase/serverless": "^1.2.0",
    "@use-gesture/react": "^10.3.1",
    "@vercel/blob": "2.8.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "luxon": "3.7.2",
    "motion": "^14.1.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/luxon": "3.7.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
