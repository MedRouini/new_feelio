# Feelio environment variables. Copy to .env and fill in. Never commit .env.
# Every value here is server-only unless its name starts with NEXT_PUBLIC_ (none do today).

# --- Database (Neon Postgres, Frankfurt; D-014, D-030) ---
# Pooled connection string from the Neon dashboard ("Connect", pooling on). Synthetic data only on the free tier.
DATABASE_URL=

# --- Auth (Better Auth; D-002) ---
# Long random secret used to sign sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Require parents to verify their email before use. Needs an email provider (not chosen yet), so false in development.
REQUIRE_EMAIL_VERIFICATION=false
# Minutes a passed adult gate (password re-check) stays valid for the parent area / for sensitive actions.
ADULT_GATE_MINUTES=30
ADULT_GATE_SENSITIVE_MINUTES=5

# --- Hosts (D-032): the child app and the parent dashboard live on separate hosts ---
# Development: the child app on localhost, the dashboard on dashboard.localhost (browsers resolve *.localhost).
APP_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://dashboard.localhost:3000

# --- Market (SPEC §8): which market config file in content/markets/ applies (strict baseline by default) ---
DEFAULT_MARKET=baseline

# --- Scheduled jobs ---
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/retention.
CRON_SECRET=

# --- Providers (used only inside safety/ from Milestone 2; never in client code) ---
# ElevenLabs API key (Agents, static TTS). Adult-only testing until written approval (D-005).
ELEVENLABS_API_KEY=
# Together AI API key (LLMs, classifier, images). Turn on zero data retention in the dashboard (D-009).
TOGETHER_API_KEY=

# --- Field encryption (CR-6) ---
# 32+ random bytes (base64url). Encrypts optional child nicknames at rest. Rotating it makes old nicknames unreadable (crypto-shred).
DATA_ENCRYPTION_KEY=
