# Feelio environment variables. Copy to .env and fill in. Never commit .env.
# Every value here is server-only unless its name starts with NEXT_PUBLIC_ (none do today).

# --- Database (Neon Postgres, Frankfurt; D-014, D-030) ---
# Pooled connection string from the Neon dashboard ("Connect", pooling on). Synthetic data only on the free tier.
DATABASE_URL=

# --- Auth (Better Auth; D-002) ---
# Long random secret used to sign sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Require parents to verify their email before use. Needs an email provider (not chosen yet), so false in development.
REQUIRE_EMAIL_VERIFICATION=false
# Minutes a passed adult gate (password re-check) stays valid for the parent area / for sensitive actions.
ADULT_GATE_MINUTES=30
ADULT_GATE_SENSITIVE_MINUTES=5

# --- Hosts (D-032): the child app and the parent dashboard live on separate hosts ---
# Development: the child app on localhost, the dashboard on dashboard.localhost (browsers resolve *.localhost).
APP_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://dashboard.localhost:3000

# --- Market (SPEC §8): which market config file in content/markets/ applies (strict baseline by default) ---
DEFAULT_MARKET=baseline

# --- Scheduled jobs ---
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/retention.
CRON_SECRET=

# --- Providers (used only inside safety/ from Milestone 2; never in client code) ---
# ElevenLabs API key (Agents, static TTS). Adult-only testing until written approval (D-005).
ELEVENLABS_API_KEY=
# Together AI API key (LLMs, classifier, images). Turn on zero data retention in the dashboard (D-009).
TOGETHER_API_KEY=
# Voice proxy (Milestone 2 spike). 32+ random characters; the ElevenLabs agent sends it as "Authorization: Bearer <secret>"
# (stored as an ElevenLabs workspace secret, never in the client). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOICE_PROXY_SECRET=
# 1 turns on the adult-only voice proxy spike (/api/voice/llm). 0 (default) answers 404. Never 1 with real children (D-005, D-061).
VOICE_SPIKE_ENABLED=0

# --- Field encryption (CR-6) ---
# 32+ random bytes (base64url). Encrypts optional child nicknames at rest. Rotating it makes old nicknames unreadable (crypto-shred).
DATA_ENCRYPTION_KEY=

# --- Fixed voice lines (D-037): ElevenLabs voices chosen by the owner, one per language ---
# Used only by `npx tsx safety/voice-lines/generate.ts --yes` (dry run without --yes). Not used at runtime.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_AR=

# --- Safety lead (D-066) ---
# Comma-separated user ids (from the user table, not email addresses) who may open /safety on the
# dashboard: the review queue with restricted events and excerpts. Leave empty to disable the page.
SAFETY_LEAD_USER_IDS=

# --- Voice companion (Milestone 5, D-068) ---
# VOICE_SPIKE_ENABLED (above) is the Milestone 2 spike, replaced by voice sessions: keep it 0. With 1, turns
# without a session get unbound adult-test replies (only for scripts/voice-latency.ts).
# Written by `npx tsx safety/voice-agent/sync.ts` after it creates the agent (not a secret).
ELEVENLABS_AGENT_ID=
# Public https base URL ElevenLabs calls for /api/voice/llm: a Cloudflare quick tunnel in development
# (`cloudflared tunnel --url http://localhost:3000`), the deployed site in production. Re-run the sync when it changes.
VOICE_PUBLIC_URL=
# Global voice switch (CR-11): 0 = off everywhere (Talk falls back to its "coming soon" screen).
VOICE_ENABLED=1
# 1 = the owner may test voice through a child profile before ElevenLabs approves use by children (D-005).
# Must stay 0 whenever a real child could use the app.
VOICE_ADULT_TESTING=0
